{
  "name": "astro-kit",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\" --fix",
    "format": "prettier -w . && bun run lint:fix",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/node": "11.1.7",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/i18n": "1.7.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "astro-seo": "1.2.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.51.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.26.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-eslint-parser": "3.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
